# Arctus Environment Variables Configuration Template
# Copy to .env and configure for production

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Flask REST API Configuration
PORT=5000
FLASK_ENV=production

# Optional External API Keys (Graceful fallbacks are built-in for RBI / CPI)
DATA_GOV_IN_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Production Database (Optional - Defaults to local SQLite arctus.db)
DATABASE_URL=sqlite:///arctus.db
